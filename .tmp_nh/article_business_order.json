[{"id":"0b211303-ad11-4c04-9256-94d646e25359","created":"2025-12-15T10:52:14.117425Z","updated":"2026-01-14T12:42:51.441821Z","date":"2026-01-14T12:42:51.283Z","version":11,"title":"How to Create a Business Order (UI & API Guide)","url":"how-to-create-a-business-order-ui-&-api-guide","text":"%3Cp%3ENiceHash%20%3Cstrong%3EBusiness%20Orders%3C%2Fstrong%3E%20are%20designed%20for%20professional%20hashrate%20buyers%20who%20need%20%3Cstrong%3Estable%2C%20predictable%20hashrate%20delivery%3C%2Fstrong%3E%20and%20more%20control%20than%20standard%20marketplace%20orders.%20For%20a%20business%20order%2C%20a%20verified%20organization%20(KYB)%20is%20required.%3C%2Fp%3E%0A%3Cp%3EThere%20are%20two%20types%20of%20business%20orders%3A%3C%2Fp%3E%20%0A%3Col%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3EFixed%20Speed%3A%20%3C%2Fstrong%3EConstant%20speed%3B%20completion%20time%20fluctuates%20based%20on%20the%20hash%20rate%20index%20price%20and%20available%20funds.%3C%2Fli%3E%0A%3Cli%3E%3Cstrong%3EFixed%20Duration%3A%3C%2Fstrong%3E%20Reverse%20logic%3B%20speed%20adapts%20to%20a%20fixed%20end%20date%2C%20influenced%20by%20the%20hash%20rate%20index%20price%20and%20available%20funds.%3C%2Fli%3E%0A%3C%2Fol%3E%0A%0A%3Cp%3EIMPORTANT%3A%20Changes%20are%20made%20every%2015%20minutes%3C%2Fp%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%0A%0A%3Ch2%3EWhat%20Is%20a%20Business%20Order%3F%3C%2Fh2%3E%0A%3Cp%3EA%20Business%20Order%20is%20a%20managed%20hashrate%20package%20assembled%20from%20available%20sellers%20on%20the%20NiceHash%20marketplace.%20It%20allows%20you%20to%20purchase%20hashrate%20with%3A%3C%2Fp%3E%0A%3Cul%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3EPriority%20Fixed%20Speed%3C%2Fstrong%3E%20delivery%20(stable%20hashrate)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3EMultiple%20algorithms%3C%2Fstrong%3E%20(SHA256AsicBoost%2C%20Scrypt%20and%20KHeavyHash)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3EMarket%20selection%3C%2Fstrong%3E%20(EU%20%2F%20USA)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3EMining%20directly%20to%20your%20own%20%3Cstrong%3Epool%3C%2Fstrong%3E%3C%2Fli%3E%0A%20%20%20%20%3Cli%3EImproved%20predictability%20for%20planning%20and%20operations%3C%2Fli%3E%0A%3C%2Ful%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%3Ch2%3EBefore%20You%20Start%3C%2Fh2%3E%0A%3Cp%3ETo%20create%20a%20Business%20Order%2C%20make%20sure%20you%20have%3A%3C%2Fp%3E%0A%3Cul%3E%0A%20%20%20%20%3Cli%3EA%20configured%20%3Cstrong%3Emining%20pool%3C%2Fstrong%3E%20in%20NiceHash%20(you%20will%20need%20the%20%3Cstrong%3EpoolId%3C%2Fstrong%3E)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3ESelected%20the%20correct%20%3Cstrong%3Ealgorithm%3C%2Fstrong%3E%20(e.g.%2C%20SHA256AsicBoost)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3EChosen%20the%20target%20%3Cstrong%3Emarket%3C%2Fstrong%3E%20(EU%20or%20USA)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3EChecked%20the%20current%20algorithm%20limits%20via%20API%20(recommended)%3C%2Fli%3E%0A%3C%2Ful%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%3Ch2%3EImportant%3A%20Check%20Algorithm%20Limits%20via%20API%3C%2Fh2%3E%0A%3Cp%3EAlgorithm%20settings%20(limits%2C%20factors%2C%20enabled%20markets)%20can%20be%20retrieved%20from%20the%20official%20endpoint%3A%3C%2Fp%3E%0A%3Cp%3E%3Cstrong%3EGET%3C%2Fstrong%3E%20%3Ccode%3E%2Fmain%2Fapi%2Fv2%2Fmining%2Falgorithms%3C%2Fcode%3E%3C%2Fp%3E%0A%3Cp%3EUse%20this%20endpoint%20to%20verify%3A%3C%2Fp%3E%0A%3Cul%3E%0A%20%20%20%20%3Cli%3E%3Ccode%3EminimalOrderAmount%3C%2Fcode%3E%20(minimum%20BTC%20amount)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Ccode%3EminSpeedLimit%3C%2Fcode%3E%20and%20%3Ccode%3EmaxSpeedLimit%3C%2Fcode%3E%20(valid%20speed%20range)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Ccode%3EdisplayMarketFactor%3C%2Fcode%3E%20and%20%3Ccode%3EmarketFactor%3C%2Fcode%3E%20(required%20units%20and%20scaling)%3C%2Fli%3E%0A%3C%2Ful%3E%0A%3Cp%3EDocumentation%20(parameter%20details)%3A%20%3Ca%20href%3D%22https%3A%2F%2Fwww.nicehash.com%2Fdocs%2Frest%2F%23!%2Falgorithm-controller%2FgetAlgorithms%22%3EMINING%20ALGORITHMS%20%E2%80%93%20GET%20%2Fmain%2Fapi%2Fv2%2Fmining%2Falgorithms%3C%2Fa%3E.%3C%2Fp%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%3Ch2%3EOption%201%3A%20Create%20a%20Business%20Order%20via%20the%20Interface%20(UI)%3C%2Fh2%3E%0A%3Cp%3EUse%20the%20NiceHash%20interface%20if%20you%20want%20a%20guided%2C%20manual%20setup.%3C%2Fp%3E%0A%3Col%3E%0A%20%20%20%20%3Cli%3ELog%20in%20to%20NiceHash.%3C%2Fli%3E%0A%20%20%20%20%3Cli%3ENavigate%20to%20%3Cstrong%3EHashrate%20Marketplace%20%E2%86%92%20Business%20Orders%3C%2Fstrong%3E.%3C%2Fli%3E%0A%20%20%20%20%3Cli%3ESelect%20your%20%3Cstrong%3Emarket%3C%2Fstrong%3E%20(EU%20%2F%20USA).%3C%2Fli%3E%0A%20%20%20%20%3Cli%3EChoose%20the%20%3Cstrong%3Ealgorithm%3C%2Fstrong%3E%20(e.g.%2C%20SHA256AsicBoost).%3C%2Fli%3E%0A%20%20%20%20%3Cli%3ESelect%20or%20add%20your%20%3Cstrong%3Emining%20pool%3C%2Fstrong%3E.%3C%2Fli%3E%0A%20%20%20%20%3Cli%3ESelect%20the%20type%20of%20Business%20order%3C%2Fli%3E%0A%20%20%20%20%3Cli%3EFor%20a%20%3Cstrong%3Efixed%20speed%3C%2Fstrong%3E%20set%20amount%20and%20the%20speed%20limit.%20For%20a%26nbsp%3B%3Cstrong%3Efixed%20duration%2C%26nbsp%3B%3C%2Fstrong%3Eset%26nbsp%3B%20amount%2C%20bottom%20speed%20limit%2C%20and%20the%20end%20date.%26nbsp%3B%3C%2Fli%3E%0A%20%20%20%20%3Cli%3EReview%20and%20confirm%20the%20order.%3C%2Fli%3E%0A%3C%2Fol%3E%0A%3Cp%3E%3Cimg%20src%3D%22https%3A%2F%2Fstatic.nicehash.com%2Fmarketing%252Fbusiness_orders.png%22%20alt%3D%22Business%20orders%20UI%22%20width%3D%22780%22%20height%3D%22224%22%3E%3Cbr%3E%3C%2Fp%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%3Ch2%3EOption%202%3A%20Create%20a%20Business%20Order%20with%20a%20fixed%20speed%20via%20API%20%3C%2Fh2%3E%0A%3Cp%3EThe%20API%20method%20is%20recommended%20if%20you%20want%3A%3C%2Fp%3E%0A%3Cul%3E%0A%20%20%20%20%3Cli%3EExplicit%20selection%20of%20%3Cstrong%3EFixed%20Speed%3C%2Fstrong%3E%20(%3Ccode%3EsubType%3C%2Fcode%3E)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3EPrecise%20speed%20configuration%20(including%20decimal%20precision%20above%20the%20minimum)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3EAutomation%2C%20retries%2C%20scaling%2C%20and%20integration%20into%20internal%20tooling%3C%2Fli%3E%0A%3C%2Ful%3E%0A%3Cp%3EReference%20implementation%20and%20HMAC%20signing%20examples%20are%20available%20here%3A%20%3Ca%20href%3D%22https%3A%2F%2Fgithub.com%2Fnicehash%2Frest-clients-demo%22%3ENiceHash%20REST%20Clients%20Demo%20(GitHub)%3C%2Fa%3E.%3C%2Fp%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%3Ch2%3EAPI%20Calls%20Used%20in%20a%20Typical%20Business%20Order%20Flow%3C%2Fh2%3E%0A%3Cp%3EThese%20endpoints%20are%20commonly%20used%20when%20placing%20Business%20Orders%20programmatically%3A%3C%2Fp%3E%0A%3Cul%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3ERead%20algorithm%20limits%20%26amp%3B%20factors%3A%3C%2Fstrong%3E%20%3Ccode%3EGET%20%2Fmain%2Fapi%2Fv2%2Fmining%2Falgorithms%3C%2Fcode%3E%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3EList%20pools%3A%3C%2Fstrong%3E%20%3Ccode%3EGET%20%2Fmain%2Fapi%2Fv2%2Fpool%3C%2Fcode%3E%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3ECreate%20a%20pool%20(if%20needed)%3A%3C%2Fstrong%3E%20%3Ccode%3EPOST%20%2Fmain%2Fapi%2Fv2%2Fpool%3C%2Fcode%3E%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3ECreate%20a%20Business%20Order%3A%3C%2Fstrong%3E%20%3Ccode%3EPOST%20%2Fmain%2Fapi%2Fv2%2Fhashpower%2Fbusiness%2Forder%3C%2Fcode%3E%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3EMonitor%20order%20status%3A%3C%2Fstrong%3E%20%3Ccode%3EGET%20%2Fmain%2Fapi%2Fv2%2Fhashpower%2Forder%2F%26lt%3BorderId%26gt%3B%3C%2Fcode%3E%3C%2Fli%3E%0A%3C%2Ful%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%3Ch2%3EFixed%20Speed%20Basics%20(SHA256AsicBoost%20Example)%3C%2Fh2%3E%0A%3Cp%3EFor%20%3Cstrong%3ESHA256ASICBOOST%3C%2Fstrong%3E%2C%20Business%20Orders%20use%20%3Cstrong%3EEH%3C%2Fstrong%3E%20as%20the%20speed%20unit.%3C%2Fp%3E%0A%3Cp%3E%3Cstrong%3EMinimum%20speed%20rule%3A%3C%2Fstrong%3E%20your%20%3Ccode%3Elimit%3C%2Fcode%3E%20must%20be%20greater%20than%20or%20equal%20to%20the%20algorithm%E2%80%99s%20minimum%20(%3Ccode%3EminSpeedLimit%3C%2Fcode%3E%20%2F%20derived%20minLimit).%20This%20is%20a%20%3Cstrong%3Eminimum%20speed%20constraint%3C%2Fstrong%3E%2C%20not%20a%20decimal%20precision%20limitation.%3C%2Fp%3E%0A%3Cp%3EExamples%20(values%20in%20EH)%3A%3C%2Fp%3E%0A%3Cul%3E%0A%20%20%20%20%3Cli%3E%3Ccode%3E0.0001%3C%2Fcode%3E%20(minimum%20threshold%20example)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Ccode%3E0.00011%3C%2Fcode%3E%20(valid%2C%20higher%20than%20minimum)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Ccode%3E0.0001234%3C%2Fcode%3E%20(valid%2C%20more%20decimal%20precision)%3C%2Fli%3E%0A%3C%2Ful%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%3Ch2%3EExample%20A%3A%20Small%20Fixed-Speed%20Business%20Order%20(1%20PH%20Equivalent)%3C%2Fh2%3E%0A%3Cp%3EThis%20example%20demonstrates%20a%20small%2C%20precise%20fixed%20speed%20using%20decimals.%20(Speed%20values%20are%20expressed%20in%20EH.)%3C%2Fp%3E%0A%3Cpre%3E%3Ccode%3E%7B%0A%20%20%22market%22%3A%20%22EU%22%2C%0A%20%20%22algorithm%22%3A%20%22SHA256ASICBOOST%22%2C%0A%20%20%22amount%22%3A%201%2C%0A%20%20%22displayMarketFactor%22%3A%20%22EH%22%2C%0A%20%20%22marketFactor%22%3A%201000000000000000000%2C%0A%20%20%22limit%22%3A%200.0001%2C%0A%20%20%22displayPriceFactor%22%3A%20%22EH%22%2C%0A%20%20%22priceFactor%22%3A%201000000000000000000%2C%0A%20%20%22poolId%22%3A%20%22your_pool_id%22%2C%0A%20%20%22subType%22%3A%20%22BUSINESS_FIXED_SPEED%22%0A%7D%3C%2Fcode%3E%3C%2Fpre%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%3Ch2%3EExample%20B%3A%20Fixed-Speed%20Business%20Order%20(25%20PH%20for%2030%20Days)%3C%2Fh2%3E%0A%3Cp%3ETo%20target%20%3Cstrong%3E25%20PH%3C%2Fstrong%3E%20on%20SHA256AsicBoost%2C%20convert%20to%20EH%3A%3C%2Fp%3E%0A%3Cul%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3E1%20PH%20%3D%200.001%20EH%3C%2Fstrong%3E%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3E25%20PH%20%3D%200.025%20EH%3C%2Fstrong%3E%3C%2Fli%3E%0A%3C%2Ful%3E%0A%3Cp%3EUse%20a%20speed%20window%20that%20includes%20your%20target.%20For%20example%3A%3C%2Fp%3E%0A%3Cul%3E%0A%20%20%20%20%3Cli%3E%3Ccode%3EbottomLimit%20%3D%200.02%3C%2Fcode%3E%20(20%20PH)%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Ccode%3Elimit%20%3D%200.03%3C%2Fcode%3E%20(30%20PH)%3C%2Fli%3E%0A%3C%2Ful%3E%0A%3Cpre%3E%3Ccode%3E%7B%0A%20%20%22market%22%3A%20%22EU%22%2C%0A%20%20%22algorithm%22%3A%20%22SHA256ASICBOOST%22%2C%0A%20%20%22amount%22%3A%200.05%2C%0A%20%20%22displayMarketFactor%22%3A%20%22EH%22%2C%0A%20%20%22marketFactor%22%3A%201000000000000000000%2C%0A%20%20%22displayPriceFactor%22%3A%20%22EH%22%2C%0A%20%20%22priceFactor%22%3A%201000000000000000000%2C%0A%20%20%22poolId%22%3A%20%224007f83c-0b2d-49bc-b51c-584d27215f28%22%2C%0A%20%20%22bottomLimit%22%3A%200.02%2C%0A%20%20%22limit%22%3A%200.03%2C%0A%20%20%22subType%22%3A%20%22BUSINESS_FIXED_SPEED%22%0A%7D%3C%2Fcode%3E%3C%2Fpre%3E%0A%3Cp%3E%3Cstrong%3ENote%3A%3C%2Fstrong%3E%20If%20the%20backend%20cannot%20allocate%20the%20full%20package%20at%20that%20moment%2C%20you%20may%20receive%20an%20allocation%20error.%20In%20that%20case%2C%20try%20again%20later%2C%20widen%20the%20speed%20window%20slightly%2C%20switch%20markets%20(EU%2FUSA)%2C%20or%20split%20the%20order%20into%20smaller%20ones.%3C%2Fp%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%3Ch2%3ETroubleshooting%20Common%20Errors%3C%2Fh2%3E%0A%3Cul%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3E5068%20%E2%80%93%20Invalid%20order%20market%20factor%3C%2Fstrong%3E%3A%20Wrong%20unit%20or%20factor%20(must%20match%20%3Ccode%3E%2Fmining%2Falgorithms%3C%2Fcode%3E).%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3E2997%20%E2%80%93%20Invalid%20order%20amount%20or%20limit%20or%20price%3C%2Fstrong%3E%3A%20Amount%20too%20low%2C%20invalid%20speed%20window%2C%20or%20limit%20below%20minimum.%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Cstrong%3E5191%20%E2%80%93%20Unable%20to%20allocate%20hashrate%3C%2Fstrong%3E%3A%20Valid%20request%2C%20insufficient%20supply%3B%20retry%20or%20split.%3C%2Fli%3E%0A%3C%2Ful%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%3Ch2%3EAdditional%20Resources%3C%2Fh2%3E%0A%3Cul%3E%0A%20%20%20%20%3Cli%3E%3Ca%20href%3D%22https%3A%2F%2Fwww.nicehash.com%2Fdocs%2Frest%2F%23!%2Falgorithm-controller%2FgetAlgorithms%22%3EMINING%20ALGORITHMS%20%E2%80%93%20GET%20%2Fmain%2Fapi%2Fv2%2Fmining%2Falgorithms%3C%2Fa%3E%3C%2Fli%3E%0A%20%20%20%20%3Cli%3E%3Ca%20href%3D%22https%3A%2F%2Fgithub.com%2Fnicehash%2Frest-clients-demo%22%3ENiceHash%20REST%20Clients%20Demo%20(GitHub)%3C%2Fa%3E%3C%2Fli%3E%0A%3C%2Ful%3E%0A%3Cp%3E%3Cbr%3E%3C%2Fp%3E%0A%0A%3Ch2%3ESummary%3C%2Fh2%3E%0A%3Cp%3EYou%20can%20place%20Business%20Orders%20either%20through%20the%20NiceHash%20interface%20or%20via%20API.%20The%20API%20approach%20is%20recommended%20for%20professional%20buyers%20who%20want%20automation%20and%20better%20control.%3C%2Fp%3E%0A%3Cp%3EAlways%20validate%20algorithm%20limits%20using%20-%26nbsp%3B%3Ccode%3EGET%20%2Fmain%2Fapi%2Fv2%2Fmining%2Falgorithms.%26nbsp%3B%3C%2Fcode%3EThen%20construct%20your%20order%20payload%20accordingly.%3C%2Fp%3E","category":"help","sub":"hash-power-marketplace","subsub":"orders","position":0,"lang":"en","meta":{},"published":true}]